MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_DB=
MONGO_HOST=
MONGO_PORT=
MOSAIC_ADMIN=
MOSAIC_ADMIN_PASSWORD=
JWT_SECRET_KEY=

# Linux data directory. Production services should set this explicitly,
# for example to /var/lib/pcibex/ibex.
PCIBEX_DATA_DIR=

# Public URL used to construct experiment links.
BASE_APPLICATION_URL=http://localhost:4200
PORT=3001

# Keep the local origins for direct development API calls. For same-origin
# production behind Nginx, set this to an empty value.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
