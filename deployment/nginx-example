server {
    if ($host = <your server-name>) {
        return 301 https://$host$request_uri;
    } 

    listen 80;
    server_name <your server-name>;
    return 301 https://$host$request_uri;

}

server {
    listen 443 ssl;
    server_name <your server-name>;
    ssl_certificate <your certificate path>; 
    ssl_certificate_key <your certificate key path>;

    root /var/www/vd-pcibex/browser;
    location /robots.txt { try_files $uri =404; }
    location = / {
        return 302 /login;
    }
    # === Proxy rules from proxy.conf.json to handle API calls associated with PCIbex Experiment Access ===
    location /www/ {
        proxy_pass http://127.0.0.1:3001/www/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
     location /api/ {
        proxy_pass http://127.0.0.1:3001/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /data_includes/ {
        proxy_pass http://127.0.0.1:3001/data_includes/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

    }
    location /css_includes/ {
        proxy_pass http://127.0.0.1:3001/css_includes/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

    }
    location /other_includes/ {
        proxy_pass http://127.0.0.1:3001/other_includes/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

    }
    location /js_includes/ {
        proxy_pass http://127.0.0.1:3001/js_includes/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /send {
        limit_except POST {
         deny all;
        }
        proxy_pass http://127.0.0.1:3001/send;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
   location /counter/ {
        proxy_pass http://127.0.0.1:3001/counter?$query_string;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

