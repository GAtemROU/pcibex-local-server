[Unit]
Description=Quart Hypercorn Web Service (PCIbex)
After=network.target

[Service]
User=pcibex
Group=pcibex
UMask=0002
WorkingDirectory=/opt/pcibex/current
EnvironmentFile=/etc/pcibex/production.env
ExecStart=/opt/pcibex/current/.venv/bin/hypercorn pcibex_server.server:app --bind 127.0.0.1:3001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
